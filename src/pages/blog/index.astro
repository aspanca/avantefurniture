---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Journal"
  description="News, project stories, and updates from the Avante furniture team."
>
  <section class="page-hero">
    <div class="container reveal">
      <p class="section-eyebrow">Journal</p>
      <h1>Stories from the studio</h1>
      <p class="lead">Project updates, design notes, and company news.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="empty reveal">No posts yet — add your first in Netlify CMS at /admin.</p>
        ) : (
          <ul class="blog-list">
            {posts.map((post) => (
              <li class="reveal">
                <article>
                  <a href={`/blog/${post.slug}`}>
                    {post.data.image && (
                      <img src={post.data.image} alt="" width="400" height="240" loading="lazy" />
                    )}
                    <div>
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </time>
                      <h2>{post.data.title}</h2>
                      <p>{post.data.description}</p>
                    </div>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 3rem 0 1rem;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 0 0 0.5rem;
  }

  .lead {
    color: var(--color-muted);
    margin: 0;
  }

  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .blog-list a {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    text-decoration: none;
    padding: 1.5rem;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform var(--transition);
  }

  .blog-list a:hover {
    color: inherit;
    transform: translateY(-4px);
  }

  .blog-list img {
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    border-radius: 8px;
  }

  .blog-list time {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .blog-list h2 {
    margin: 0.35rem 0;
    font-size: 1.35rem;
  }

  .blog-list p {
    margin: 0;
    color: var(--color-muted);
  }

  .empty {
    text-align: center;
    color: var(--color-muted);
    padding: 3rem;
  }

  @media (max-width: 600px) {
    .blog-list a {
      grid-template-columns: 1fr;
    }
  }
</style>
