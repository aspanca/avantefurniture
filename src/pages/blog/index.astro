---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPostImages } from '../../lib/posts';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Journal"
  description="News, project stories, and updates from the Avante furniture team."
>

  <!-- ── Hero ── -->
  <section class="blog-hero">
    <div class="container reveal">
      <p class="eyebrow">
        <span class="eyebrow-line"></span>
        Journal
      </p>
      <h1 class="blog-headline">Stories from<br>the studio.</h1>
      <p class="blog-lead">Project updates, design notes, and company news.</p>
    </div>
  </section>

  <!-- ── Posts ── -->
  <section class="blog-body section">
    <div class="container">
      {posts.length === 0 ? (
        <div class="empty-state reveal">
          <p>No posts yet.</p>
          <a href="/admin" class="btn btn-outline">Add one in the CMS →</a>
        </div>
      ) : (
        <div class="post-grid">
          {posts.map((post, i) => {
            const images = getPostImages(post);
            const cover = images[0]?.src;
            const photoCount = images.length;

            return (
              <a
                href={`/blog/${post.slug}`}
                class="post-card reveal"
                style={`transition-delay: ${(i % 3) * 0.1}s`}
              >
                <div class="post-card-img">
                  {cover ? (
                    <>
                      <img
                        src={cover}
                        alt=""
                        width="560"
                        height="360"
                        loading={i < 3 ? 'eager' : 'lazy'}
                      />
                      {photoCount > 1 && (
                        <span class="photo-badge">
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                            <rect x="1" y="3" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                            <circle cx="6" cy="7" r="1.5" stroke="currentColor" stroke-width="1.2"/>
                            <path d="M4 3V2.5a1 1 0 011-1h2a1 1 0 011 1V3" stroke="currentColor" stroke-width="1.2"/>
                          </svg>
                          {photoCount}
                        </span>
                      )}
                    </>
                  ) : (
                    <div class="post-card-placeholder" />
                  )}
                </div>
                <div class="post-card-body">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric', month: 'short', day: 'numeric',
                    })}
                  </time>
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <span class="post-read">
                    Read more
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path d="M2 7h10M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .blog-hero {
    padding: 4rem 0 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-headline {
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 1.06;
    margin: 0.5rem 0 1rem;
  }

  .blog-lead {
    font-size: 1.1rem;
    color: var(--color-muted);
    margin: 0;
    max-width: 48ch;
  }

  /* ── Post grid ── */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }

  .post-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    color: inherit;
  }

  .post-card-img {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .post-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .post-card:hover .post-card-img img { transform: scale(1.05); }

  .post-card-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-border), var(--color-accent-light));
  }

  .photo-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    background: rgba(13, 11, 9, 0.75);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .post-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .post-card-body time {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .post-card-body h2 {
    font-size: 1.1rem;
    margin: 0.15rem 0 0.25rem;
    line-height: 1.3;
  }

  .post-card-body p {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-read {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: gap 0.2s ease;
  }

  .post-card:hover .post-read { gap: 0.6rem; }

  /* Empty */
  .empty-state {
    text-align: center;
    padding: 5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .empty-state p {
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .post-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .post-grid { grid-template-columns: 1fr; }
  }
</style>
