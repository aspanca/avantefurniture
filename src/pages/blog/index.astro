---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPostImages } from '../../lib/posts';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Journal"
  description="News, project stories, and updates from the Avante furniture team."
>
  <section class="page-hero">
    <div class="container reveal">
      <p class="section-eyebrow">Journal</p>
      <h1>Stories from the studio</h1>
      <p class="lead">Project updates, design notes, and company news.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="empty reveal">No posts yet — add your first in Netlify CMS at /admin.</p>
        ) : (
          <ul class="blog-list">
            {posts.map((post) => {
              const images = getPostImages(post);
              const cover = images[0]?.src;
              const photoCount = images.length;

              return (
                <li class="reveal">
                  <article class="blog-card">
                    <a href={`/blog/${post.slug}`} class="blog-card-link">
                      <div class="blog-card-media">
                        {cover ? (
                          <img src={cover} alt="" width="400" height="240" loading="lazy" />
                        ) : (
                          <div class="blog-card-placeholder" aria-hidden="true" />
                        )}
                        {photoCount > 1 && (
                          <span class="photo-badge">{photoCount} photos</span>
                        )}
                      </div>
                      <div class="blog-card-body">
                        <time datetime={post.data.pubDate.toISOString()}>
                          {post.data.pubDate.toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                          })}
                        </time>
                        <h2>{post.data.title}</h2>
                        <p class="blog-card-desc">{post.data.description}</p>
                        <span class="read-more">View post →</span>
                      </div>
                    </a>
                  </article>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: 3rem 0 1rem;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin: 0 0 0.5rem;
  }

  .lead {
    color: var(--color-muted);
    margin: 0;
  }

  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .blog-card-link {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: 1.5rem;
    text-decoration: none;
    padding: 1.25rem;
    background: var(--color-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .blog-card-link:hover {
    color: inherit;
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(26, 26, 26, 0.12);
  }

  .blog-card-media {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }

  .blog-card-media img {
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .blog-card-link:hover .blog-card-media img {
    transform: scale(1.04);
  }

  .blog-card-placeholder {
    aspect-ratio: 5 / 3;
    background: linear-gradient(135deg, var(--color-border), var(--color-accent-soft));
  }

  .photo-badge {
    position: absolute;
    bottom: 0.65rem;
    right: 0.65rem;
    padding: 0.25rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(26, 26, 26, 0.75);
    color: #fff;
    border-radius: 999px;
  }

  .blog-card-body time {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .blog-card-body h2 {
    margin: 0.35rem 0 0.5rem;
    font-size: 1.35rem;
  }

  .blog-card-desc {
    margin: 0 0 1rem;
    color: var(--color-muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-accent);
  }

  .empty {
    text-align: center;
    color: var(--color-muted);
    padding: 3rem;
  }

  @media (max-width: 700px) {
    .blog-card-link {
      grid-template-columns: 1fr;
    }
  }
</style>
