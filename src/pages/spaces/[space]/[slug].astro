---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ImageCarousel from '../../../components/ImageCarousel.astro';
import { SPACES } from '../../../lib/site';
import { getProjectImages, getSpaceLabel } from '../../../lib/projects';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { space: project.data.category, slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { space, slug } = Astro.params;
const spaceConfig = SPACES[space as keyof typeof SPACES];

if (!spaceConfig || project.data.category !== space || project.slug !== slug) {
  return Astro.redirect('/404');
}

const { Content } = await project.render();
const images = getProjectImages(project);
const spaceLabel = getSpaceLabel(project.data.category);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image}
>
  <article class="project-article">

    <!-- ── Header ── -->
    <header class="project-header" style={`--accent: ${spaceConfig.accent}`}>
      <div class="container project-header-inner reveal">
        <a href={`/spaces/${space}`} class="back-link">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13 8H3M7 12l-4-4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {spaceLabel}
        </a>
        <p class="project-category" style={`color: ${spaceConfig.accent}`}>{spaceLabel}</p>
        <h1 class="project-title">{project.data.title}</h1>
        <p class="project-desc">{project.data.description}</p>
      </div>
    </header>

    <!-- ── Carousel ── -->
    {images.length > 0 && (
      <div class="container carousel-wrap reveal">
        <ImageCarousel images={images} label={`Photos of ${project.data.title}`} />
      </div>
    )}

    <!-- ── Content ── -->
    <div class="container project-layout reveal">
      <aside class="project-sidebar">
        <div class="project-meta-card" style={`--accent-soft: color-mix(in srgb, ${spaceConfig.accent} 10%, transparent)`}>
          <dl class="project-meta">
            <div>
              <dt>Space</dt>
              <dd>{spaceLabel}</dd>
            </div>
            {images.length > 1 && (
              <div>
                <dt>Photos</dt>
                <dd>{images.length} images</dd>
              </div>
            )}
          </dl>
        </div>
        <a href="/contact" class="btn btn-primary sidebar-btn">Request a quote</a>
        <a href={`/spaces/${space}`} class="btn btn-outline sidebar-btn">More {spaceLabel.toLowerCase()}</a>
      </aside>

      <div class="project-body">
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>

  </article>
</BaseLayout>

<style>
  .project-header {
    padding: 3.5rem 0 2rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 6%, transparent),
      transparent
    );
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.5rem;
  }

  .project-header-inner { max-width: 720px; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-muted);
    transition: color 0.2s, gap 0.2s;
  }

  .back-link:hover { color: var(--color-text); gap: 0.6rem; }

  .project-category {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 0.5rem;
  }

  .project-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .project-desc {
    font-size: 1.05rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.65;
    max-width: 56ch;
  }

  .carousel-wrap {
    margin-bottom: 3rem;
  }

  /* ── Layout ── */
  .project-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 3.5rem;
    align-items: start;
    padding-bottom: 5rem;
  }

  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: sticky;
    top: 5.5rem;
  }

  .project-meta-card {
    background: var(--accent-soft, var(--color-accent-light));
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-bottom: 0.25rem;
  }

  .project-meta { margin: 0; }

  .project-meta div { margin-bottom: 0.9rem; }
  .project-meta div:last-child { margin-bottom: 0; }

  .project-meta dt {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 0.2rem;
  }

  .project-meta dd {
    margin: 0;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .sidebar-btn { width: 100%; }

  .project-body { min-width: 0; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .project-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .project-sidebar {
      position: static;
      order: -1;
    }
  }
</style>
