---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { SPACES } from '../../lib/site';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return Object.keys(SPACES).map((space) => ({
    params: { space },
  }));
}

const { space } = Astro.params;
const config = SPACES[space as keyof typeof SPACES];

if (!config) {
  return Astro.redirect('/404');
}

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter((p) => p.data.category === space)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={config.title}
  description={config.description}
  image={config.image}
>

  <!-- ── Hero ── -->
  <section class="space-hero" style={`--accent: ${config.accent}`}>
    <div class="container space-hero-inner">
      <div class="reveal">
        <p class="eyebrow" style={`color: ${config.accent}`}>
          <span class="eyebrow-line"></span>
          {config.title}
        </p>
        <h1 class="space-headline">{config.headline}</h1>
        <p class="space-lead">{config.description}</p>
        <a href="/contact" class="btn btn-primary">Request a quote</a>
      </div>
      <div class="space-hero-img reveal reveal-delay-2">
        <img
          src={config.image}
          alt={`${config.title} furniture by Avante`}
          width="640"
          height="480"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- ── Projects ── -->
  <section class="projects-section section">
    <div class="container">
      <div class="projects-head reveal">
        <p class="eyebrow">
          <span class="eyebrow-line"></span>
          Featured work
        </p>
        <h2>Our {config.title.toLowerCase()} projects</h2>
      </div>
      {projects.length > 0 ? (
        <ProjectGrid projects={projects} />
      ) : (
        <p class="empty reveal">Projects coming soon.</p>
      )}
    </div>
  </section>

  <!-- ── Other Spaces ── -->
  <nav class="other-spaces" aria-label="Other spaces">
    <div class="container other-spaces-inner">
      <p class="eyebrow eyebrow--light reveal">
        <span class="eyebrow-line"></span>
        Explore more
      </p>
      <div class="other-spaces-links">
        {Object.values(SPACES)
          .filter((s) => s.slug !== space)
          .map((s, i) => (
            <a
              href={`/spaces/${s.slug}`}
              class="other-space-link reveal"
              style={`--accent: ${s.accent}; transition-delay: ${(i + 1) * 0.1}s`}
            >
              <span class="other-space-label">{s.title}</span>
              <span class="other-space-sub">{s.headline}</span>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4 9h10M9 5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </nav>

</BaseLayout>

<style>
  /* ── Hero ── */
  .space-hero {
    padding: 4rem 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent) 6%, transparent),
      transparent 80%
    );
  }

  .space-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .space-headline {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.06;
    margin: 0.5rem 0 1.25rem;
  }

  .space-lead {
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 44ch;
  }

  .space-hero-img {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .space-hero-img img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 0.7s var(--ease-out);
  }

  .space-hero-img:hover img { transform: scale(1.03); }

  /* ── Projects ── */
  .projects-head {
    margin-bottom: 2.5rem;
  }

  .projects-head h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    margin-top: 0.5rem;
  }

  .empty {
    color: var(--color-muted);
    font-size: 1rem;
    padding: 2rem 0;
  }

  /* ── Other spaces ── */
  .other-spaces {
    background: var(--color-dark);
    padding: 4rem 0;
  }

  .other-spaces-inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .other-spaces-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .other-space-link {
    flex: 1;
    min-width: 200px;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.75rem;
    background: var(--color-dark-2);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-inverse);
    border: 1px solid rgba(255,255,255,0.06);
    transition: background 0.25s, transform 0.25s var(--ease-out);
  }

  .other-space-link:hover {
    background: var(--color-dark-3);
    color: var(--color-inverse);
    transform: translateY(-3px);
  }

  .other-space-label {
    font-weight: 700;
    font-size: 1rem;
    display: block;
    margin-bottom: 0.2rem;
  }

  .other-space-sub {
    font-size: 0.8rem;
    color: rgba(245, 240, 232, 0.45);
    display: block;
  }

  .other-space-link svg {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }

  .other-space-link:hover svg {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .space-hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .other-spaces-links { flex-direction: column; }
    .other-space-link { flex: none; }
  }
</style>
