---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroWords from '../components/HeroWords';
import Marquee from '../components/Marquee.astro';
import { SITE, SPACES, SERVICES } from '../lib/site';
import { getCollection } from 'astro:content';
import { getProjectHref } from '../lib/projects';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = await getCollection('projects');

function getSpaceHref(slug: keyof typeof SPACES) {
  const project = allProjects
    .filter((p) => p.data.category === slug)
    .sort((a, b) => {
      if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
      return a.data.order - b.data.order;
    })[0];
  return project ? getProjectHref(project) : `/spaces/${slug}`;
}

const spaceList = Object.values(SPACES);
const marqueeItems = [
  'Kitchens', 'Living Rooms', 'Bedrooms', 'Offices', 'Dining Rooms', 'Bathrooms',
  'Complete Homes', 'End-to-End Design', 'Avante', 'Built to Last', 'Turning Houses into Homes',
];
---

<BaseLayout title={SITE.name} description={SITE.description}>

  <!-- ═══════════════════════════════════════
       HERO  — dark cinematic full-screen split
  ═══════════════════════════════════════ -->
  <section class="hero" aria-label="Avante hero">

    <!-- Left: dark copy panel -->
    <div class="hero-left">
      <!-- Brand mark as huge ghosted BG -->
      <span class="hero-bg-mark" aria-hidden="true">
        <svg viewBox="0 0 120 76" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" fill="currentColor"
            d="M 0 76 L 66 0 L 120 0 L 120 76 Z M 74 9 L 103 9 L 103 38 L 74 38 Z"/>
        </svg>
      </span>

      <div class="hero-copy">
        <p class="eyebrow eyebrow--light reveal">
          <span class="eyebrow-line"></span>
          {SITE.tagline}
        </p>
        <HeroWords client:load lines={['We design', 'spaces that', 'move you.']} dark={true} />
        <p class="hero-lead reveal reveal-delay-2">
          From a single room to a complete home — Avante delivers end-to-end interior
          design and furniture with the energy and precision your space deserves.
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="/contact" class="btn btn-primary">Start a project</a>
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="hero-ig-btn btn-ghost-light">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
            Instagram
          </a>
        </div>
      </div>

      <!-- Space chips -->
      <div class="hero-chips reveal reveal-delay-4">
        {spaceList.map((space) => (
          <a href={getSpaceHref(space.slug)} class="space-chip" style={`--accent: ${space.accent}`}>
            <span class="chip-dot" aria-hidden="true"></span>
            {space.title}
          </a>
        ))}
      </div>
    </div>

    <!-- Right: full-bleed image panel -->
    <div class="hero-right">
      <div class="hero-img-wrap">
        <img
          src="/images/hero-kitchen.svg"
          alt="Modern kitchen interior designed by Avante"
          width="900"
          height="1200"
          fetchpriority="high"
          class="hero-img"
        />
        <div class="hero-img-overlay" aria-hidden="true"></div>
      </div>

      <!-- Floating badge -->
      <div class="hero-badge" aria-hidden="true">
        <strong>50+</strong>
        <span>Projects<br>delivered</span>
      </div>

      <!-- Scroll hint -->
      <div class="hero-scroll-hint" aria-hidden="true">
        <span class="scroll-line"></span>
        <span>Scroll</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       MARQUEE
  ═══════════════════════════════════════ -->
  <Marquee items={marqueeItems} dark={true} />

  <!-- ═══════════════════════════════════════
       BRAND STATEMENT
  ═══════════════════════════════════════ -->
  <section class="statement-section">
    <div class="container">
      <div class="statement-inner reveal">
        <span class="statement-dash" aria-hidden="true">—</span>
        <blockquote class="statement-quote">
          "Turning houses into homes."
          <cite>Avante Furniture</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SPACES
  ═══════════════════════════════════════ -->
  <section class="spaces-section">
    <div class="container spaces-head">
      <div class="reveal">
        <p class="eyebrow">
          <span class="eyebrow-line"></span>
          Our work
        </p>
        <h2 class="spaces-title">Every room.<br>One vision.</h2>
      </div>
      <p class="spaces-sub reveal reveal-delay-1">
        From the kitchen where life begins to the living room where it unfolds —
        we design and furnish every corner of your home, end to end.
      </p>
    </div>

    <div class="spaces-strip">
      {spaceList.map((space, i) => (
        <a
          href={getSpaceHref(space.slug)}
          class="space-card reveal"
          style={`--accent: ${space.accent}; transition-delay: ${i * 0.12}s`}
        >
          <div class="space-card-bg">
            <img src={space.image} alt="" width="600" height="800" loading={i === 0 ? 'eager' : 'lazy'} />
            <div class="space-card-overlay" />
          </div>
          <div class="space-card-body">
            <span class="space-num">0{i + 1}</span>
            <div class="space-card-text">
              <h3>{space.title}</h3>
              <p>{space.headline}</p>
            </div>
            <span class="space-cta">
              View work
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       FULL SERVICE
  ═══════════════════════════════════════ -->
  <section class="service-section">
    <div class="container service-inner">
      <div class="service-head reveal">
        <p class="eyebrow">
          <span class="eyebrow-line"></span>
          What we do
        </p>
        <h2 class="service-title">End-to-end.<br>Every room.</h2>
        <p class="service-lead">
          We don't just sell furniture — we design, plan, source, and install
          complete interiors. One team, one vision, from first sketch to final room.
        </p>
      </div>

      <ul class="service-grid">
        {SERVICES.map((s, i) => (
          <li class="service-item reveal" style={`transition-delay: ${(i % 4) * 0.07}s`}>
            <span class="service-dot" aria-hidden="true"></span>
            {s.label}
          </li>
        ))}
      </ul>

      <div class="service-cta reveal">
        <a href="/contact" class="btn btn-primary">Get a free consultation</a>
        <p class="service-note">No commitment. Just a conversation about your space.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       STATS
  ═══════════════════════════════════════ -->
  <section class="stats-section">
    <div class="container stats-inner">
      <div class="stats-copy">
        <p class="eyebrow eyebrow--light reveal">
          <span class="eyebrow-line"></span>
          Why Avante
        </p>
        <h2 class="stats-heading reveal reveal-delay-1">A real company,<br>not a catalog.</h2>
        <p class="stats-lead reveal reveal-delay-2">
          Our crew is young, hands-on, and obsessed with getting details right.
          We show up, measure twice, and build furniture that feels alive in your home.
        </p>
        <a href="/about" class="btn btn-outline-light reveal reveal-delay-3">Our story →</a>
      </div>

      <div class="stats-grid">
        <div class="stat-item reveal reveal-delay-1">
          <div class="stat-num-wrap">
            <strong class="stat-num" data-count="50">0</strong>
            <span class="stat-suffix">+</span>
          </div>
          <p>Projects delivered</p>
        </div>
        <div class="stat-item reveal reveal-delay-2">
          <div class="stat-num-wrap">
            <strong class="stat-num" data-count="12">0</strong>
          </div>
          <p>Designers &amp; craftspeople</p>
        </div>
        <div class="stat-item reveal reveal-delay-3">
          <div class="stat-num-wrap">
            <strong class="stat-num" data-count="3">0</strong>
          </div>
          <p>Core specialties</p>
        </div>
        <div class="stat-item reveal reveal-delay-4">
          <div class="stat-num-wrap">
            <strong class="stat-num" data-count="100">0</strong>
            <span class="stat-suffix">%</span>
          </div>
          <p>Client satisfaction</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       JOURNAL
  ═══════════════════════════════════════ -->
  {posts.length > 0 && (
    <section class="journal-section">
      <div class="container">
        <div class="journal-head reveal">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span>Journal</p>
            <h2>From the studio</h2>
          </div>
          <a href="/blog" class="btn btn-outline">All posts →</a>
        </div>
        <div class="journal-grid">
          {posts.map((post, i) => (
            <a href={`/blog/${post.slug}`} class="jcard reveal" style={`transition-delay: ${i * 0.1}s`}>
              <div class="jcard-img">
                {post.data.image
                  ? <img src={post.data.image} alt="" width="480" height="320" loading="lazy" />
                  : <div class="jcard-placeholder" />}
              </div>
              <div class="jcard-body">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}
                </time>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="jcard-read">
                  Read more
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2 7h10M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════
       INSTAGRAM  — prominent social CTA
  ═══════════════════════════════════════ -->
  <section class="ig-section">
    <div class="container ig-inner">
      <div class="ig-copy reveal">
        <p class="eyebrow eyebrow--light">
          <span class="eyebrow-line"></span>
          Follow the process
        </p>
        <h2 class="ig-heading">See our work<br>on Instagram.</h2>
        <p class="ig-lead">
          Behind-the-scenes builds, finished spaces, and daily inspiration
          from our studio in Kosovo.
        </p>
        <a
          href={SITE.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary ig-btn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
          @avantefurniture
        </a>
      </div>

      <div class="ig-visual reveal reveal-delay-1" aria-hidden="true">
        <div class="ig-grid">
          {spaceList.map((space, i) => (
            <div class="ig-tile" style={`--accent: ${space.accent}; --i: ${i}`}>
              <img src={space.image} alt="" loading="lazy" />
              <div class="ig-tile-overlay"></div>
            </div>
          ))}
          <div class="ig-handle-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
            <span>@avantefurniture</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       CONTACT FORM (Netlify)
  ═══════════════════════════════════════ -->
  <section class="home-contact-section">
    <div class="container home-contact-inner">
      <div class="hc-copy reveal">
        <p class="eyebrow eyebrow--light">
          <span class="eyebrow-line"></span>
          Get in touch
        </p>
        <h2 class="hc-heading">Start your project<br>today.</h2>
        <p class="hc-lead">
          Tell us about your space. We respond within one business day —
          always a real person, never a bot.
        </p>
        <div class="hc-contact-links">
          {SITE.social.whatsapp.map((w) => (
            <a href={w.href} target="_blank" rel="noopener noreferrer" class="hc-wa">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              {w.label}
            </a>
          ))}
        </div>
      </div>

      <div class="hc-form-wrap reveal reveal-delay-1">
        <!-- Success state (hidden by default) -->
        <div class="form-success" id="form-success" aria-live="polite">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
            <circle cx="24" cy="24" r="22" stroke="var(--color-accent)" stroke-width="2"/>
            <path d="M14 24l7 7 13-13" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h3>Message received!</h3>
          <p>We'll be in touch within one business day.</p>
        </div>

        <form
          class="hc-form"
          id="home-contact-form"
          name="home-contact"
          method="POST"
          action="/success"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="home-contact" />
          <p class="hidden"><label>Skip: <input name="bot-field" /></label></p>

          <div class="hc-row">
            <label class="hc-label">
              <span>Name</span>
              <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
            </label>
            <label class="hc-label">
              <span>Email</span>
              <input type="email" name="email" required autocomplete="email" placeholder="your@email.com" />
            </label>
          </div>

          <label class="hc-label">
            <span>What do you need?</span>
            <select name="space" required>
              <option value="">Select a room…</option>
              <option value="kitchen">Kitchen</option>
              <option value="living">Living Room</option>
              <option value="bedroom">Bedroom</option>
              <option value="dining">Dining Room</option>
              <option value="office">Office / Study</option>
              <option value="bathroom">Bathroom</option>
              <option value="complete">Complete Home</option>
              <option value="other">Other / Multiple</option>
            </select>
          </label>

          <label class="hc-label">
            <span>Message</span>
            <textarea name="message" rows="4" required placeholder="Tell us about your project…"></textarea>
          </label>

          <button type="submit" class="btn btn-primary hc-submit">
            Send message
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       CTA
  ═══════════════════════════════════════ -->
  <section class="cta-section">
    <div class="container cta-inner">
      <div class="cta-copy">
        <p class="eyebrow eyebrow--light reveal"><span class="eyebrow-line"></span>Ready?</p>
        <h2 class="cta-heading reveal reveal-delay-1">Let's build something<br>worth living in.</h2>
        <p class="cta-lead reveal reveal-delay-2">
          Whether it's a dream kitchen, a productive office, or a peaceful bedroom —
          we're ready to design it with you.
        </p>
      </div>
      <div class="cta-actions reveal reveal-delay-3">
        <a href="/contact" class="btn btn-primary btn-cta-lg">Start a project</a>
        <a href="/spaces/kitchen" class="btn btn-ghost-light">
          Browse work
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ══════════════════════════════════
     HERO
  ══════════════════════════════════ */
  .hero {
    display: grid;
    grid-template-columns: 52% 48%;
    min-height: 100dvh;
    overflow: hidden;
  }

  /* ── Left dark panel ── */
  .hero-left {
    background: var(--color-dark);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5rem 4rem 3rem;
    position: relative;
    overflow: hidden;
  }

  /* Huge ghost mark in background */
  .hero-bg-mark {
    position: absolute;
    bottom: -8%;
    right: -12%;
    width: 80%;
    opacity: 0.04;
    color: #fff;
    pointer-events: none;
    user-select: none;
  }

  .hero-bg-mark svg { width: 100%; height: auto; }

  .hero-copy { position: relative; z-index: 1; }

  .hero-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(228, 238, 236, 0.6);
    max-width: 42ch;
    margin: 1.75rem 0 2rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-ig-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Space chips */
  .hero-chips {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .space-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(228,238,236,0.7);
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    letter-spacing: 0.01em;
  }

  .space-chip:hover {
    background: rgba(255,255,255,0.12);
    color: #fff;
    border-color: var(--accent, rgba(255,255,255,0.3));
  }

  .chip-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent, var(--color-accent));
    flex-shrink: 0;
  }

  /* ── Right image panel ── */
  .hero-right {
    position: relative;
    overflow: hidden;
  }

  .hero-img-wrap {
    position: absolute;
    inset: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 10s ease;
  }

  .hero-right:hover .hero-img { transform: scale(1.04); }

  .hero-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgba(38, 51, 59, 0.55) 0%,
      rgba(38, 51, 59, 0.1) 60%,
      transparent 100%
    );
  }

  /* Floating badge */
  .hero-badge {
    position: absolute;
    bottom: 3rem;
    left: -1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.375rem;
    background: var(--color-surface);
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(26,37,48,0.2);
    animation: float 4.5s ease-in-out infinite;
    z-index: 2;
  }

  .hero-badge strong {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero-badge span {
    font-size: 0.78rem;
    color: var(--color-muted);
    font-weight: 500;
    line-height: 1.4;
  }

  /* Scroll hint */
  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.4);
    z-index: 2;
