---
import type { CollectionEntry } from 'astro:content';
import { getProjectHref } from '../lib/projects';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="project-grid">
  {
    projects.map((project) => {
      const href = getProjectHref(project);
      const photoCount = 1 + (project.data.gallery?.length ?? 0);

      return (
        <li class="project-item reveal">
          <a href={href} class="project-card-link">
            <div class="project-card-media">
              <img
                src={project.data.image}
                alt={project.data.title}
                width="480"
                height="320"
                loading="lazy"
              />
              {photoCount > 1 && <span class="photo-badge">{photoCount} photos</span>}
            </div>
            <div class="project-card-body">
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <span class="view-details">View details →</span>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-card-link {
    display: block;
    text-decoration: none;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .project-card-link:hover {
    color: inherit;
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(26, 26, 26, 0.12);
  }

  .project-card-media {
    position: relative;
    overflow: hidden;
  }

  .project-card-media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card-link:hover .project-card-media img {
    transform: scale(1.04);
  }

  .photo-badge {
    position: absolute;
    bottom: 0.65rem;
    right: 0.65rem;
    padding: 0.25rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(26, 26, 26, 0.75);
    color: #fff;
    border-radius: 999px;
  }

  .project-card-body {
    padding: 1.25rem;
  }

  .project-card-body h3 {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
  }

  .project-card-body p {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .view-details {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-accent);
  }
</style>
