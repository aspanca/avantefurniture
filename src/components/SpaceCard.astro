---
interface Props {
  title: string;
  headline: string;
  description: string;
  href: string;
  image: string;
  accent: string;
}

const { title, headline, description, href, image, accent } = Astro.props;
---

<article class="space-card reveal">
  <a href={href} class="space-card-link">
    <div class="space-card-image" style={`--accent: ${accent}`}>
      <img src={image} alt="" width="600" height="400" loading="lazy" />
      <span class="space-card-badge">{title}</span>
    </div>
    <div class="space-card-body">
      <h3>{headline}</h3>
      <p>{description}</p>
      <span class="space-card-cta">Explore {title.toLowerCase()} →</span>
    </div>
  </a>
</article>

<style>
  .space-card-link {
    display: block;
    text-decoration: none;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .space-card-link:hover {
    color: inherit;
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(26, 26, 26, 0.12);
  }

  .space-card-image {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .space-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .space-card-link:hover .space-card-image img {
    transform: scale(1.05);
  }

  .space-card-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    padding: 0.35rem 0.85rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 999px;
  }

  .space-card-body {
    padding: 1.5rem;
  }

  .space-card-body h3 {
    margin: 0 0 0.5rem;
    font-size: 1.35rem;
  }

  .space-card-body p {
    margin: 0 0 1rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .space-card-cta {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-accent);
  }
</style>
