---
import { SITE, SPACES } from '../lib/site';
const year = new Date().getFullYear();
const spaceList = Object.values(SPACES);
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Avante home">
        <img src="/images/logo-white.png" alt={SITE.name} class="footer-logo-img" width="120" height="40" />
      </a>
      <p class="footer-tagline">{SITE.tagline}</p>
      <p class="footer-desc">{SITE.description}</p>
    </div>

    <div class="footer-links">
      <div>
        <p class="footer-heading">Work</p>
        <ul>
          {spaceList.map((s) => (
            <li><a href={`/spaces/${s.slug}`}>{s.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="footer-heading">Company</p>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/blog">Journal</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/admin">CMS Login</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-heading">Get in touch</p>
        <p class="footer-contact">
          <a href={`mailto:${SITE.email}`} class="footer-contact-link footer-email-link">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true" class="contact-icon">
              <rect x="2" y="5" width="16" height="11" rx="2"/>
              <path d="M2 7l8 5 8-5"/>
            </svg>
            {SITE.email}
          </a>
        </p>
        {SITE.social.whatsapp.map((w) => (
          <p class="footer-contact">
            <a href={w.href} target="_blank" rel="noopener noreferrer" class="footer-contact-link footer-wa-link">
              <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" aria-hidden="true" class="contact-icon">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              {w.label}
            </a>
          </p>
        ))}
        <p class="footer-contact footer-location-item">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true" class="contact-icon" style="flex-shrink:0;margin-top:2px">
            <path d="M10 2a6 6 0 0 1 6 6c0 4.5-6 10-6 10S4 12.5 4 8a6 6 0 0 1 6-6z"/>
            <circle cx="10" cy="8" r="2"/>
          </svg>
          <span>{SITE.location}</span>
        </p>
        <div class="footer-social">
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Avante on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Avante on Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
        <a href="/contact" class="footer-cta">
          Start a project
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="footer-copy">&copy; {year} {SITE.name}. All rights reserved.</p>
    <p class="footer-made">Crafted with care.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    color: rgba(245, 240, 232, 0.65);
    padding: 5rem 0 2.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.7fr 2.3fr;
    gap: 4rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-border-dark);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: opacity 0.2s;
  }

  .footer-logo:hover { opacity: 1; }

  .footer-logo-img {
    height: 62px;
    width: auto;
    display: block;
    mix-blend-mode: screen;
  }

  .footer-tagline {
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }

  .footer-desc {
    color: rgba(245, 240, 232, 0.38);
    font-size: 0.875rem;
    line-height: 1.65;
    max-width: 32ch;
    margin: 0;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-heading {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(245, 240, 232, 0.3);
    margin: 0 0 1.25rem;
  }

  .footer ul { list-style: none; margin: 0; padding: 0; }
  .footer li { margin-bottom: 0.7rem; }

  .footer a {
    color: rgba(245, 240, 232, 0.55);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer a:hover { color: #fff; }

  .footer-contact {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
  }

  .footer-contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(245, 240, 232, 0.55);
    text-decoration: none;
    transition: color 0.2s;
    font-size: 0.875rem;
  }

  .footer-contact-link:hover { color: #fff; }

  .footer-wa-link:hover { color: #25d366; }

  .footer-location-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: rgba(245, 240, 232, 0.4);
    font-size: 0.8rem;
    line-height: 1.45;
    margin-top: 0.75rem;
  }

  .contact-icon { flex-shrink: 0; }

  .footer-social {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0 0.5rem;
  }

  .footer-social-link {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid rgba(245, 240, 232, 0.15);
    color: rgba(245, 240, 232, 0.5);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    text-decoration: none;
  }

  .footer-social-link:hover {
    border-color: rgba(245, 240, 232, 0.4);
    color: #fff;
    background: rgba(245, 240, 232, 0.06);
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-accent) !important;
    transition: gap 0.2s ease;
  }

  .footer-cta:hover { gap: 0.6rem; }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    gap: 1rem;
  }

  .footer-copy,
  .footer-made {
    margin: 0;
    font-size: 0.78rem;
    color: rgba(245, 240, 232, 0.25);
  }

  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr; gap: 2.5rem; }
    .footer-links { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 600px) {
    .footer-links { grid-template-columns: 1fr 1fr; }
    .footer-links > div:last-child { grid-column: 1 / -1; }
  }

  @media (max-width: 400px) {
    .footer-links { grid-template-columns: 1fr; }
  }
</style>
