---
import { SITE, NAV, SPACES } from '../lib/site';

const pathname = Astro.url.pathname;
const isSpacePath = pathname.startsWith('/spaces');
const spaceList = Object.values(SPACES);
---

<header class="header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <span class="logo-mark" aria-hidden="true">A</span>
      <span class="logo-text">{SITE.name}</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav-list">
        <li class="nav-item has-dropdown">
          <button
            type="button"
            class:list={['nav-link nav-work-btn', { active: isSpacePath }]}
            aria-expanded="false"
            aria-haspopup="true"
          >
            Work
            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="dropdown" role="menu">
            {spaceList.map((space) => (
              <a
                href={`/spaces/${space.slug}`}
                class="dropdown-item"
                role="menuitem"
                style={`--item-accent: ${space.accent}`}
              >
                <span class="dropdown-item-accent" aria-hidden="true" />
                <span class="dropdown-item-body">
                  <span class="dropdown-item-title">{space.title}</span>
                  <span class="dropdown-item-desc">{space.headline}</span>
                </span>
                <svg class="dropdown-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </div>
        </li>

        {NAV.filter((n) => n.href !== '/').map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class:list={['nav-link', { active: pathname.startsWith(item.href) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="btn btn-primary nav-cta">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(248, 245, 240, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-border);
    transition: background 0.35s, box-shadow 0.35s;
  }

  .header.is-scrolled {
    background: rgba(248, 245, 240, 0.97);
    box-shadow: 0 1px 0 var(--color-border), 0 4px 24px rgba(28, 22, 10, 0.04);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0;
    gap: 2rem;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
    color: var(--color-text);
    transition: opacity 0.2s;
  }

  .logo:hover { opacity: 0.75; color: var(--color-text); }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: var(--font-display);
    font-weight: 800;
    flex-shrink: 0;
    transition: transform 0.25s var(--ease-out);
  }

  .logo:hover .logo-mark { transform: rotate(-6deg) scale(1.06); }

  /* Nav */
  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    transition: color 0.15s, background 0.15s;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    line-height: inherit;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
    background: rgba(28, 25, 20, 0.05);
  }

  .nav-link.active { font-weight: 600; }

  .nav-cta {
    margin-left: 0.75rem;
    padding: 0.55rem 1.1rem;
    font-size: 0.84rem;
  }

  .chevron {
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .nav-work-btn[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .nav-item { position: relative; }

  .dropdown {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    min-width: 264px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(28, 22, 10, 0.12);
    padding: 0.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 200;
  }

  .dropdown::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px;
    height: 10px;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
  }

  .dropdown.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text);
    transition: background 0.15s;
  }

  .dropdown-item:hover { background: rgba(28, 25, 20, 0.04); color: var(--color-text); }

  .dropdown-item-accent {
    width: 4px;
    height: 36px;
    border-radius: 99px;
    background: var(--item-accent);
    flex-shrink: 0;
  }

  .dropdown-item-body { flex: 1; min-width: 0; }

  .dropdown-item-title {
    display: block;
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 0.15rem;
  }

  .dropdown-item-desc {
    display: block;
    font-size: 0.775rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-arrow {
    color: var(--color-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.15s;
  }

  .dropdown-item:hover .dropdown-arrow { transform: translateX(3px); color: var(--color-text); }

  /* Mobile */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s;
  }

  @media (max-width: 800px) {
    .nav-toggle { display: flex; }
    .nav-cta { display: none; }

    .nav {
      position: fixed;
      inset: 0 0 auto 0;
      top: 3.5rem;
      flex-direction: column;
      align-items: stretch;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem;
      transform: translateY(-110%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .nav.is-open { transform: translateY(0); opacity: 1; pointer-events: auto; }

    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }

    .nav-link {
      padding: 0.75rem 0.5rem;
      font-size: 1rem;
      border-radius: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .dropdown {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      border-radius: 0;
      background: transparent;
      padding: 0 0 0 1rem;
      border-bottom: 1px solid var(--color-border);
      display: none;
      opacity: 1;
    }

    .dropdown.is-open {
      display: block;
      transform: none;
      pointer-events: auto;
    }

    .dropdown::before { display: none; }
    .dropdown-item { padding: 0.6rem 0.5rem; border-radius: 6px; }
    .nav-work-btn { border-bottom: 1px solid var(--color-border); }
    .nav-work-btn[aria-expanded='true'] { border-bottom: none; }

    .nav-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
    .nav-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    nav?.classList.toggle('is-open', !open);
  });

  const workBtn = document.querySelector<HTMLButtonElement>('.nav-work-btn');
  const dropdown = document.querySelector<HTMLElement>('.dropdown');

  const openDd  = () => { workBtn?.setAttribute('aria-expanded', 'true');  dropdown?.classList.add('is-open'); };
  const closeDd = () => { workBtn?.setAttribute('aria-expanded', 'false'); dropdown?.classList.remove('is-open'); };

  workBtn?.addEventListener('click', () => {
    workBtn.getAttribute('aria-expanded') === 'true' ? closeDd() : openDd();
  });

  document.addEventListener('click', (e) => {
    if (!workBtn?.closest('.has-dropdown')?.contains(e.target as Node)) closeDd();
  });

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDd(); });

  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 20);
  }, { passive: true });
</script>
