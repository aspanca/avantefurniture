---
import { SITE, NAV, SPACES } from '../lib/site';

const pathname = Astro.url.pathname;
const isSpacePath = pathname.startsWith('/spaces');
const spaceList = Object.values(SPACES);
---

<!-- ── Top bar ── -->
<div class="topbar" id="topbar">
  <div class="container topbar-inner">
    <div class="topbar-left">
      <span class="topbar-hours">
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.25"/>
          <path d="M7 4v3l2 2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
        Mon – Sat &nbsp;10:00 – 19:00
      </span>
    </div>
    <div class="topbar-right">
      {SITE.social.whatsapp.slice(0,1).map((w) => (
        <a href={w.href} target="_blank" rel="noopener noreferrer" class="topbar-link topbar-wa">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {w.label}
        </a>
      ))}
      <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="topbar-link topbar-ig" aria-label="Instagram">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
        </svg>
        @avantefurniture
      </a>
    </div>
  </div>
</div>

<!-- ── Main header ── -->
<header class="header" id="site-header">
  <div class="container header-inner">

    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <img src="/images/logo-white.png" alt={SITE.name} class="logo-img" width="120" height="40" />
    </a>

    <!-- Mobile toggle -->
    <button type="button" class="nav-toggle" id="nav-toggle"
      aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
    </button>

    <!-- Desktop nav -->
    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        <li class="nav-item has-dropdown">
          <button type="button"
            class:list={['nav-link nav-work-btn', { active: isSpacePath }]}
            aria-expanded="false" aria-haspopup="true">
            Work
            <svg class="chevron" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <!-- Mega dropdown -->
          <div class="dropdown" role="menu">
            <div class="dropdown-grid">
              {spaceList.map((space) => (
                <a href={`/spaces/${space.slug}`} class="dropdown-item" role="menuitem"
                  style={`--item-accent: ${space.accent}`}>
                  <span class="di-bar" aria-hidden="true"/>
                  <span class="di-body">
                    <span class="di-title">{space.title}</span>
                    <span class="di-desc">{space.headline}</span>
                  </span>
                </a>
              ))}
            </div>
            <div class="dropdown-footer">
              <a href="/contact" class="dropdown-cta">
                Get a free consultation
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 7h10M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </li>

        {NAV.filter((n) => n.href !== '/').map((item) => (
          <li class="nav-item">
            <a href={item.href}
              class:list={['nav-link', { active: pathname.startsWith(item.href) }]}>
              {item.label}
              <span class="nav-underline" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>

      <a href="/contact" class="nav-cta">
        Start a project
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </nav>
  </div>
</header>

<!-- ── Full-screen mobile menu ── -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="dialog" aria-label="Navigation menu">
  <div class="mm-bg" id="mm-bg"></div>
  <div class="mm-inner">

    <div class="mm-top">
      <a href="/" class="mm-logo" aria-label="Avante home">
        <img src="/images/logo-white.png" alt={SITE.name} class="mm-logo-img" />
      </a>
      <button type="button" class="mm-close" id="mm-close" aria-label="Close menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="mm-nav" aria-label="Mobile navigation">
      <ul class="mm-list">
        <li class="mm-item" style="--i:0">
          <a href="/" class="mm-link">
            <span class="mm-num">01</span>
            <span class="mm-label">Home</span>
          </a>
        </li>
        {spaceList.map((space, i) => (
          <li class="mm-item" style={`--i:${i+1}`}>
            <a href={`/spaces/${space.slug}`} class="mm-link mm-space-link" style={`--accent: ${space.accent}`}>
              <span class="mm-num">0{i+2}</span>
              <span class="mm-label">{space.title}</span>
              <span class="mm-sub">{space.headline}</span>
            </a>
          </li>
        ))}
        <li class="mm-item" style="--i:6">
          <a href="/about" class="mm-link">
            <span class="mm-num">07</span>
            <span class="mm-label">About</span>
          </a>
        </li>
        <li class="mm-item" style="--i:7">
          <a href="/blog" class="mm-link">
            <span class="mm-num">08</span>
            <span class="mm-label">Journal</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="mm-footer">
      <a href="/contact" class="btn btn-primary mm-cta">Start a project</a>
      <div class="mm-contact">
        <span class="mm-hours">
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.25"/>
            <path d="M7 4v3l2 2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          </svg>
          Mon – Sat &nbsp;10:00 – 19:00
        </span>
        <div class="mm-social">
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="mm-social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="mm-social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          {SITE.social.whatsapp.slice(0,1).map((w) => (
            <a href={w.href} target="_blank" rel="noopener noreferrer" class="mm-social-link" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* ══════════════════════════════════
     TOP BAR
  ══════════════════════════════════ */
  .topbar {
    background: var(--color-dark);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: transform 0.3s var(--ease-out), opacity 0.3s;
  }

  .topbar.is-hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0;
    gap: 1rem;
  }

  .topbar-hours {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(228, 238, 236, 0.5);
    letter-spacing: 0.04em;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .topbar-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(228, 238, 236, 0.45);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .topbar-link:hover { color: #fff; }
  .topbar-wa:hover   { color: #25d366; }
  .topbar-ig:hover   { color: var(--color-accent); }

  /* ══════════════════════════════════
     MAIN HEADER
  ══════════════════════════════════ */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(244, 246, 245, 0.9);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid var(--color-border);
    transition: background 0.35s, box-shadow 0.35s;
  }

  .header.is-scrolled {
    background: rgba(244, 246, 245, 0.98);
    box-shadow: 0 1px 0 var(--color-border), 0 8px 32px rgba(26, 37, 48, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0;
    gap: 2rem;
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }

  .logo:hover { opacity: 0.8; }

  .logo-img {
    height: 54px;
    width: auto;
    display: block;
    filter: invert(1);
    mix-blend-mode: multiply;
  }

  /* ── Nav ── */
  .nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-muted);
    padding: 0.5rem 0.9rem;
    background: none;
    border: none;
    cursor: pointer;
    line-height: inherit;
    transition: color 0.2s;
    letter-spacing: 0.01em;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px; left: 0.9rem; right: 0.9rem;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out);
    border-radius: 2px;
  }

  .nav-link:hover { color: var(--color-text); }
  .nav-link:hover::after { transform: scaleX(1); }

  .nav-link.active {
    color: var(--color-text);
    font-weight: 700;
  }

  .nav-link.active::after { transform: scaleX(1); }

  /* suppress underline on dropdown trigger (has its own indicator) */
  .nav-work-btn::after { display: none; }

  .nav-underline { display: none; } /* kept for markup compat */

  .chevron {
    transition: transform 0.25s ease;
    flex-shrink: 0;
    opacity: 0.6;
  }

  .nav-work-btn[aria-expanded='true'] .chevron { transform: rotate(180deg); }

  /* ── CTA button ── */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 0.75rem;
    padding: 0.6rem 1.25rem;
    background: var(--color-dark);
    color: var(--color-inverse);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    letter-spacing: 0.01em;
    border: 1.5px solid var(--color-dark);
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.2s var(--ease-out),
      box-shadow 0.2s;
  }

  .nav-cta:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(94,125,120,0.3);
  }

  /* ── Dropdown ── */
  .nav-item { position: relative; }

  .dropdown {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    transform: translateX(-50%) translateY(-10px);
    min-width: 360px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    box-shadow: 0 12px 48px rgba(26, 37, 48, 0.14);
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s, transform 0.22s var(--ease-out);
    z-index: 200;
  }

  .dropdown.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--color-border);
    padding: 2px;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
    transition: background 0.15s;
  }

  .dropdown-item:hover { background: var(--color-surface-alt); }
  .dropdown-item:first-child { border-radius: 16px 0 0 0; }
  .dropdown-item:nth-child(2) { border-radius: 0 16px 0 0; }

  .di-bar {
    width: 3px;
    height: 32px;
    border-radius: 99px;
    background: var(--item-accent);
    flex-shrink: 0;
  }

  .di-body { min-width: 0; }
  .di-title { display: block; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.1rem; }
  .di-desc  { display: block; font-size: 0.75rem; color: var(--color-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .dropdown-footer {
    padding: 0.875rem 1.1rem;
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-border);
  }

  .dropdown-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: gap 0.2s;
  }

  .dropdown-cta:hover { gap: 0.6rem; }

  /* ── Mobile toggle ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 6px;
    padding: 0.5rem;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 200;
  }

  .bar {
    display: block;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out), opacity 0.2s, width 0.3s var(--ease-out);
    transform-origin: center;
  }

  .bar-1 { width: 22px; }
  .bar-2 { width: 14px; }

  .nav-toggle:hover .bar-2 { width: 22px; }

  /* ══════════════════════════════════
     MOBILE OVERLAY MENU
  ══════════════════════════════════ */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 500;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .mm-bg {
    position: absolute;
    inset: 0;
    background: var(--color-dark);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .mobile-menu.is-open .mm-bg { opacity: 1; }

  .mm-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 1.5rem max(1.5rem, calc((100vw - min(1200px, 94vw)) / 2 + 1.5rem));
    transform: translateX(100%);
    transition: transform 0.45s var(--ease-out);
    overflow-y: auto;
  }

  .mobile-menu.is-open .mm-inner { transform: translateX(0); }

  .mm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.09);
    margin-bottom: 2rem;
    flex-shrink: 0;
  }

  .mm-logo { text-decoration: none; }

  .mm-logo-img {
    height: 52px;
    width: auto;
    display: block;
    mix-blend-mode: screen;
  }

  .mm-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%;
    color: rgba(255,255,255,0.8);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    flex-shrink: 0;
  }

  .mm-close:hover { background: rgba(255,255,255,0.14); color: #fff; }

  .mm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .mm-item {
    opacity: 0;
    transform: translateX(28px);
    transition:
      opacity 0.4s var(--ease-out) calc(var(--i, 0) * 0.06s + 0.08s),
      transform 0.4s var(--ease-out) calc(var(--i, 0) * 0.06s + 0.08s);
  }

  .mobile-menu.is-open .mm-item { opacity: 1; transform: translateX(0); }

  .mm-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    text-decoration: none;
    color: rgba(255,255,255,0.6);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color 0.2s;
  }

  .mm-link:hover { color: #fff; }
  .mm-link:hover .mm-num { color: var(--color-accent); }

  .mm-num {
    font-family: var(--font-ui);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.2);
    flex-shrink: 0;
    transition: color 0.2s;
    min-width: 1.8rem;
  }

  .mm-label {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .mm-sub {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
    margin-left: auto;
    align-self: center;
    white-space: nowrap;
  }

  .mm-space-link:hover .mm-label { color: var(--accent, #fff); }

  .mm-footer {
    flex-shrink: 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s var(--ease-out) 0.5s, transform 0.4s var(--ease-out) 0.5s;
  }

  .mobile-menu.is-open .mm-footer { opacity: 1; transform: translateY(0); }

  .mm-cta { align-self: flex-start; }

  .mm-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mm-hours {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(228, 238, 236, 0.4);
    letter-spacing: 0.04em;
  }

  .mm-social {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mm-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border-radius: 50%;
    color: rgba(255,255,255,0.45);
    border: 1px solid rgba(255,255,255,0.1);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .mm-social-link:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.35);
    background: rgba(255,255,255,0.08);
  }

  /* ── Responsive ── */
  @media (max-width: 800px) {
    .nav-toggle { display: flex; }
    .nav { display: none; }
    .topbar { display: none; }
  }

  @media (min-width: 801px) {
    .mobile-menu { display: none; }
  }
</style>

<script>
  /* Desktop nav */
  const workBtn  = document.querySelector<HTMLButtonElement>('.nav-work-btn');
  const dropdown = document.querySelector<HTMLElement>('.dropdown');
  const openDd   = () => { workBtn?.setAttribute('aria-expanded','true');  dropdown?.classList.add('is-open'); };
  const closeDd  = () => { workBtn?.setAttribute('aria-expanded','false'); dropdown?.classList.remove('is-open'); };
  workBtn?.addEventListener('click', () => workBtn.getAttribute('aria-expanded')==='true' ? closeDd() : openDd());
  document.addEventListener('click', (e) => { if (!workBtn?.closest('.has-dropdown')?.contains(e.target as Node)) closeDd(); });
  document.addEventListener('keydown', (e) => { if (e.key==='Escape') closeDd(); });

  /* Scroll: header state + hide topbar */
  const header = document.getElementById('site-header');
  const topbar = document.getElementById('topbar');
  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 20;
    header?.classList.toggle('is-scrolled', scrolled);
    topbar?.classList.toggle('is-hidden', window.scrollY > 60);
  }, { passive: true });

  /* Mobile menu */
  const toggle   = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const menu     = document.getElementById('mobile-menu') as HTMLElement | null;
  const closeBtn = document.getElementById('mm-close') as HTMLButtonElement | null;
  const mmBg     = document.getElementById('mm-bg') as HTMLElement | null;

  const openMenu  = () => { menu?.classList.add('is-open'); menu?.removeAttribute('aria-hidden'); toggle?.setAttribute('aria-expanded','true'); document.body.style.overflow='hidden'; };
  const closeMenu = () => { menu?.classList.remove('is-open'); menu?.setAttribute('aria-hidden','true'); toggle?.setAttribute('aria-expanded','false'); document.body.style.overflow=''; };

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  mmBg?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => { if (e.key==='Escape') closeMenu(); });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
</script>
