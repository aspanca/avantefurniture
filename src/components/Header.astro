---
import { SITE, NAV, SPACES } from '../lib/site';

const pathname = Astro.url.pathname;
const isSpacePath = pathname.startsWith('/spaces');
const spaceList = Object.values(SPACES);
---

<header class="header" id="site-header">
  <div class="container header-inner">

    <!-- Logo -->
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <img src="/images/logo-white.png" alt={SITE.name} class="logo-img" width="120" height="40" />
    </a>

    <!-- Mobile toggle -->
    <button type="button" class="nav-toggle" id="nav-toggle"
      aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Desktop nav -->
    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        <li class="nav-item has-dropdown">
          <button type="button"
            class:list={['nav-link nav-work-btn', { active: isSpacePath }]}
            aria-expanded="false" aria-haspopup="true">
            Work
            <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="dropdown" role="menu">
            {spaceList.map((space) => (
              <a href={`/spaces/${space.slug}`} class="dropdown-item" role="menuitem"
                style={`--item-accent: ${space.accent}`}>
                <span class="dropdown-item-accent" aria-hidden="true"/>
                <span class="dropdown-item-body">
                  <span class="dropdown-item-title">{space.title}</span>
                  <span class="dropdown-item-desc">{space.headline}</span>
                </span>
                <svg class="dropdown-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </div>
        </li>
        {NAV.filter((n) => n.href !== '/').map((item) => (
          <li class="nav-item">
            <a href={item.href}
              class:list={['nav-link', { active: pathname.startsWith(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/contact" class="btn btn-primary nav-cta">Get in touch</a>
    </nav>
  </div>
</header>

<!-- ── Full-screen mobile menu ── -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="dialog" aria-label="Navigation menu">
  <div class="mm-bg" id="mm-bg"></div>

  <div class="mm-inner">
    <div class="mm-top">
      <a href="/" class="mm-logo" aria-label="Avante home">
        <img src="/images/logo-white.png" alt={SITE.name} class="mm-logo-img" width="110" height="36" />
      </a>
      <button type="button" class="mm-close" id="mm-close" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="mm-nav" aria-label="Mobile navigation">
      <ul class="mm-list">
        <li class="mm-item" style="--i:0">
          <a href="/" class="mm-link">
            <span class="mm-num">01</span>
            <span class="mm-label">Home</span>
          </a>
        </li>
        {spaceList.map((space, i) => (
          <li class="mm-item" style={`--i:${i+1}`}>
            <a href={`/spaces/${space.slug}`} class="mm-link mm-space-link"
              style={`--accent: ${space.accent}`}>
              <span class="mm-num">0{i+2}</span>
              <span class="mm-label">{space.title}</span>
              <span class="mm-sub">{space.headline}</span>
            </a>
          </li>
        ))}
        <li class="mm-item" style="--i:4">
          <a href="/about" class="mm-link">
            <span class="mm-num">05</span>
            <span class="mm-label">About</span>
          </a>
        </li>
        <li class="mm-item" style="--i:5">
          <a href="/blog" class="mm-link">
            <span class="mm-num">06</span>
            <span class="mm-label">Journal</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="mm-footer">
      <a href="/contact" class="btn btn-primary mm-cta">Start a project</a>
      <div class="mm-social">
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="mm-social-link" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" class="mm-social-link" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        {SITE.social.whatsapp.map((w) => (
          <a href={w.href} target="_blank" rel="noopener noreferrer" class="mm-social-link" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Header ── */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(244, 246, 245, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-border);
    transition: background 0.35s, box-shadow 0.35s;
  }

  .header.is-scrolled {
    background: rgba(244, 246, 245, 0.97);
    box-shadow: 0 1px 0 var(--color-border), 0 4px 24px rgba(26, 37, 48, 0.04);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    gap: 2rem;
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }

  .logo:hover { opacity: 0.7; }

  .logo-img {
    height: 42px;
    width: auto;
    display: block;
    filter: invert(1);
    mix-blend-mode: multiply;
  }

  /* ── Desktop nav ── */
  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    transition: color 0.15s, background 0.15s;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    line-height: inherit;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--color-text);
    background: rgba(38, 51, 59, 0.06);
  }

  .nav-link.active { font-weight: 600; }

  .nav-cta { margin-left: 0.75rem; padding: 0.55rem 1.1rem; font-size: 0.84rem; }

  .chevron { transition: transform 0.25s ease; flex-shrink: 0; }
  .nav-work-btn[aria-expanded='true'] .chevron { transform: rotate(180deg); }

  .nav-item { position: relative; }

  .dropdown {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    min-width: 264px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(26, 37, 48, 0.12);
    padding: 0.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s;
    z-index: 200;
  }

  .dropdown::before {
    content: '';
    position: absolute;
    top: -6px; left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 10px; height: 10px;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
  }

  .dropdown.is-open { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text);
    transition: background 0.15s;
  }

  .dropdown-item:hover { background: rgba(38, 51, 59, 0.04); color: var(--color-text); }

  .dropdown-item-accent {
    width: 4px; height: 36px;
    border-radius: 99px;
    background: var(--item-accent);
    flex-shrink: 0;
  }

  .dropdown-item-body { flex: 1; min-width: 0; }
  .dropdown-item-title { display: block; font-weight: 700; font-size: 0.875rem; margin-bottom: 0.15rem; }
  .dropdown-item-desc { display: block; font-size: 0.775rem; color: var(--color-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dropdown-arrow { color: var(--color-muted); flex-shrink: 0; transition: transform 0.2s, color 0.15s; }
  .dropdown-item:hover .dropdown-arrow { transform: translateX(3px); color: var(--color-text); }

  /* ── Mobile toggle ── */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 0.5rem;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 200;
  }

  .bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out), opacity 0.2s, width 0.3s;
    transform-origin: center;
  }

  /* ── Mobile overlay menu ── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 500;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .mm-bg {
    position: absolute;
    inset: 0;
    background: var(--color-dark);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .mobile-menu.is-open .mm-bg { opacity: 1; }

  .mm-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 1.25rem var(--container-pad, 1.25rem);
    transform: translateX(100%);
    transition: transform 0.45s var(--ease-out);
  }

  .mobile-menu.is-open .mm-inner { transform: translateX(0); }

  /* Top bar */
  .mm-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    margin-bottom: 2.5rem;
  }

  .mm-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .mm-logo:hover { opacity: 0.75; }

  .mm-logo-img {
    height: 42px;
    width: auto;
    display: block;
  }

  .mm-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s;
  }

  .mm-close:hover { background: rgba(255,255,255,0.14); }

  /* Nav list */
  .mm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .mm-item {
    opacity: 0;
    transform: translateX(32px);
    transition:
      opacity 0.4s var(--ease-out) calc(var(--i, 0) * 0.07s + 0.1s),
      transform 0.4s var(--ease-out) calc(var(--i, 0) * 0.07s + 0.1s);
  }

  .mobile-menu.is-open .mm-item {
    opacity: 1;
    transform: translateX(0);
  }

  .mm-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    text-decoration: none;
    color: rgba(255,255,255,0.65);
    border-bottom: 1px solid rgba(255,255,255,0.07);
    transition: color 0.2s;
  }

  .mm-link:hover { color: #fff; }

  .mm-link:hover .mm-num { color: var(--color-accent); }

  .mm-num {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.25);
    flex-shrink: 0;
    transition: color 0.2s;
    min-width: 1.8rem;
  }

  .mm-label {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .mm-sub {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: rgba(255,255,255,0.35);
    margin-left: auto;
    align-self: center;
    white-space: nowrap;
  }

  .mm-space-link:hover .mm-label { color: var(--accent, #fff); }

  /* Footer */
  .mm-footer {
    padding-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s var(--ease-out) 0.5s, transform 0.4s var(--ease-out) 0.5s;
  }

  .mobile-menu.is-open .mm-footer { opacity: 1; transform: translateY(0); }

  .mm-cta { flex-shrink: 0; }

  .mm-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .mm-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    border-radius: 50%;
    color: rgba(255,255,255,0.55);
    border: 1px solid rgba(255,255,255,0.12);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .mm-social-link:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.08);
  }

  /* ── Responsive ── */
  @media (max-width: 800px) {
    .nav-toggle { display: flex; }
    .nav { display: none; }
  }

  @media (min-width: 801px) {
    .mobile-menu { display: none; }
  }
</style>

<script>
  /* Desktop nav */
  const workBtn = document.querySelector<HTMLButtonElement>('.nav-work-btn');
  const dropdown = document.querySelector<HTMLElement>('.dropdown');
  const openDd  = () => { workBtn?.setAttribute('aria-expanded','true');  dropdown?.classList.add('is-open'); };
  const closeDd = () => { workBtn?.setAttribute('aria-expanded','false'); dropdown?.classList.remove('is-open'); };
  workBtn?.addEventListener('click', () => workBtn.getAttribute('aria-expanded')==='true' ? closeDd() : openDd());
  document.addEventListener('click', (e) => { if (!workBtn?.closest('.has-dropdown')?.contains(e.target as Node)) closeDd(); });
  document.addEventListener('keydown', (e) => { if (e.key==='Escape') closeDd(); });

  /* Scroll state */
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 20);
  }, { passive: true });

  /* Mobile menu */
  const toggle   = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const menu     = document.getElementById('mobile-menu') as HTMLElement | null;
  const closeBtn = document.getElementById('mm-close') as HTMLButtonElement | null;
  const mmBg     = document.getElementById('mm-bg') as HTMLElement | null;

  function openMenu() {
    menu?.classList.add('is-open');
    menu?.removeAttribute('aria-hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('is-open');
    menu?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  mmBg?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

  /* Close on nav link click */
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
</script>
