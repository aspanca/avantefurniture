---
interface Props {
  items: string[];
  speed?: number;
  dark?: boolean;
}
const { items, speed = 38, dark = false } = Astro.props;
const doubled = [...items, ...items];
---

<div class:list={['marquee', { 'marquee--dark': dark }]} aria-hidden="true">
  <div class="marquee-inner" style={`--speed: ${speed}s`}>
    {doubled.map((item) => (
      <span class="marquee-item">
        {item}
        <span class="marquee-dot" aria-hidden="true">·</span>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding: 1.05rem 0;
    border-block: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .marquee--dark {
    background: var(--color-dark);
    border-color: transparent;
  }

  .marquee-inner {
    display: flex;
    white-space: nowrap;
    animation: marquee-scroll var(--speed) linear infinite;
    will-change: transform;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1.25rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
  }

  .marquee--dark .marquee-item {
    color: rgba(245, 240, 232, 0.22);
  }

  .marquee-dot {
    color: var(--color-accent);
    font-size: 0.85em;
    margin-left: 0.2rem;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-inner { animation: none; }
  }
</style>
